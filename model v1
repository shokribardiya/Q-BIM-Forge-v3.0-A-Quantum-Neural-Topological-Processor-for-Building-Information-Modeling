def RY(theta):
    c = math.cos(theta/2)
    s = math.sin(theta/2)
    return [[c, -s], [s, c]]

def RZ(theta):
    # e^{-i theta/2 Z} = cos(theta/2) I - i sin(theta/2) Z
    c = math.cos(theta/2)
    s = math.sin(theta/2)
    return [[c - 1j*s, 0], [0, c + 1j*s]]

