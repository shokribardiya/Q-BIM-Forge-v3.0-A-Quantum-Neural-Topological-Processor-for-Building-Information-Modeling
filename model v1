class QuantumCircuit4:
    """
    A 4-qubit circuit with parameterized RY rotations and entangling CNOTs.
    Structure as in ASCII diagram. 8 trainable parameters.
    """
    def __init__(self):
        self.n_qubits = 4
        self.params = [random.uniform(0, 2*math.pi) for _ in range(8)]  # p0..p7
        self.grad = [0.0]*8

    def _build_initial_state(self, input_angles):
        """input_angles: list of 4 floats, apply RY to each |0>."""
        state0 = [1.0, 0.0]  # |0>
        # For each qubit, apply RY and take tensor product
        states = []
        for ang in input_angles:
            gate = RY(ang)
            q_state = mat_vec_mul(gate, state0)
            states.append(q_state)
        return tensor_product_vecs(states)

    def forward(self, x):
        """x: list of 4 floats (angles), returns 4 expectation values <Z_i>."""
        state = self._build_initial_state(x)
        p = self.params
        # Apply circuit gates: sequence of gates from diagram
        # Layer 1: CNOT pattern
        # We'll apply gates one by one using full matrix construction.
        # Gate order (from left to right):
        # 1. CNOT q0->q1 (control=0, target=1)
        state = self._apply_CNOT(state, 0, 1)
        # 2. CNOT q2->q3 (2->3)
        state = self._apply_CNOT(state, 2, 3)
        # 3. CNOT q0->q2 (0->2)
        state = self._apply_CNOT(state, 0, 2)
        # 4. CNOT q1->q3 (1->3)
        state = self._apply_CNOT(state, 1, 3)
        # 5. CNOT q2->q3 (again? diagram shows multiple, but we follow: q0-q1, q2-q3, q0-q2, q1-q3, q2-q3?
        # Let's simplify: After first block, apply RY(p0..p3) on each qubit.
        # RY(p0) on q0
        state = self._apply_RY(state, 0, p[0])
        # RY(p1) on q1
        state = self._apply_RY(state, 1, p[1])
        # RY(p2) on q2
        state = self._apply_RY(state, 2, p[2])
        # RY(p3) on q3
        state = self._apply_RY(state, 3, p[3])
        # Then CNOT q0-q1 (again)
        state = self._apply_CNOT(state, 0, 1)
        # CNOT q2-q3
        state = self._apply_CNOT(state, 2, 3)
        # CNOT q0-q2
        state = self._apply_CNOT(state, 0, 2)
        # CNOT q1-q3
        state = self._apply_CNOT(state, 1, 3)
        # RY(p4..p7)
        state = self._apply_RY(state, 0, p[4])
        state = self._apply_RY(state, 1, p[5])
        state = self._apply_RY(state, 2, p[6])
        state = self._apply_RY(state, 3, p[7])
        # Measure expectation Z for each qubit
        exps = []
        for i in range(self.n_qubits):
            exps.append(self._expectation_Z(state, i))
        return exps

    def _apply_CNOT(self, state, control, target):
        """Apply CNOT gate by constructing full matrix and multiplying."""
        # Build list of matrices for each qubit: identity, but for pair (control,target) we put CNOT as 4x4 matrix acting on those two.
        # We'll combine control and target into one tensor factor if they are adjacent? No, they are not necessarily adjacent.
        # Use permutation to reorder qubits to make them adjacent, then apply CNOT, then permute back.
        # Simpler: construct full 16x16 matrix using for loops over basis states.
        dim = 1 << self.n_qubits
        new_state = [0.0] * dim
        for i in range(dim):
            # i is basis state in integer. Bits: i0,i1,i2,i3 (LSB? we need consistent indexing)
            # Assume qubit 0 is LSB (least significant bit). That simplifies shifting.
            # control, target are indices 0..3.
            bit_ctrl = (i >> control) & 1
            if bit_ctrl == 1:
                bit_targ = (i >> target) & 1
                # flip target bit
                j = i ^ (1 << target)
            else:
                j = i
            new_state[j] += state[i]
        return new_state

    def _apply_RY(self, state, target, theta):
        """Apply RY(theta) to target qubit."""
        gate = RY(theta)
        return apply_gate(state, gate, target, self.n_qubits)

    def _expectation_Z(self, state, qubit):
        """Compute <Z> = prob(0) - prob(1)."""
        prob0 = 0.0
        for i, amp in enumerate(state):
            if ((i >> qubit) & 1) == 0:
                prob0 += abs(amp)**2
        # prob1 = 1 - prob0
        return prob0 - (1 - prob0)

    def backward(self, grad_output, x):
        """grad_output: gradient of loss w.r.t each expectation value (list of 4).
        Returns: gradient w.r.t input x (list of 4), and updates self.grad for parameters.
        Uses parameter-shift rule for RY gates.
        """
        # For each parameter, we compute d<Z_i>/d_param for each i, then chain with grad_output.
        # We'll compute full Jacobian J (4 x 8) and (4 x 4) input gradient.
        # Use finite difference? We'll implement analytical parameter-shift.
        # Since circuit is not too deep, we can compute exact gradients using the fact that RY gates have shift rule:
        # d/dθ <O> = 1/2 (<O>_{θ+π/2} - <O>_{θ-π/2})
        # We'll need to run forward pass for shifted parameters.
        original_params = self.params[:]
        # Initialize gradients for params
        self.grad = [0.0]*8
        # Compute gradient for each param
        for p_idx in range(8):
            # shift +π/2
            self.params = original_params[:]
            self.params[p_idx] += math.pi/2
            exps_plus = self.forward(x)
            # shift -π/2
            self.params = original_params[:]
            self.params[p_idx] -= math.pi/2
            exps_minus = self.forward(x)
            # restore
            self.params = original_params[:]
            # parameter-shift gradient for each observable
            for obs_idx in range(4):
                d_exp = 0.5 * (exps_plus[obs_idx] - exps_minus[obs_idx])
                self.grad[p_idx] += grad_output[obs_idx] * d_exp

        # Gradient w.r.t input x (angles). Input x only affects the initial RY rotations.
        # We can treat them similarly: for each input angle x_i, shift to compute d<O>/dx_i.
        grad_input = [0.0]*4
        for i in range(4):
            orig_x = x[i]
            # shift +π/2
            x_plus = x[:]
            x_plus[i] += math.pi/2
            exps_plus = self.forward(x_plus)
            # shift -π/2
            x_minus = x[:]
            x_minus[i] -= math.pi/2
            exps_minus = self.forward(x_minus)
            for obs_idx in range(4):
                d_exp = 0.5 * (exps_plus[obs_idx] - exps_minus[obs_idx])
                grad_input[i] += grad_output[obs_idx] * d_exp
        return grad_input

