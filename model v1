def tensor_product_vecs(vecs):
    """Compute tensor product of multiple state vectors. vecs: list of vectors for each qubit."""
    result = vecs[0][:]
    for v in vecs[1:]:
        new = []
        for a in result:
            for b in v:
                new.append(a * b)
        result = new
    return result

