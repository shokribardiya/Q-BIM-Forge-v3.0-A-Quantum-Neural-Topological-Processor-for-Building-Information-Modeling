def generate_bim_graph(structural_label):
    """Generate a small BIM-like graph with nodes having features: [x_norm, y_norm, z_norm, volume_norm, degree]."""
    n_nodes = random.randint(4, 6)
    # Generate random positions and volumes
    node_features = []
    for _ in range(n_nodes):
        x = random.random()
        y = random.random()
        z = random.random()
        vol = random.random()
        # degree placeholder, will fill after adjacency
        node_features.append([x, y, z, vol, 0.0])
    # Build adjacency based on proximity (simulate structural connections)
    adj = [[] for _ in range(n_nodes)]
    for i in range(n_nodes):
        for j in range(i+1, n_nodes):
            # distance
            dx = node_features[i][0] - node_features[j][0]
            dy = node_features[i][1] - node_features[j][1]
            dz = node_features[i][2] - node_features[j][2]
            dist = math.sqrt(dx*dx+dy*dy+dz*dz)
            if dist < 0.6:  # threshold
                adj[i].append(j)
                adj[j].append(i)
    # update degree feature
    for i in range(n_nodes):
        node_features[i][4] = len(adj[i])
    # Label: structural (1) if the graph has many connections or certain volume patterns; we'll make a rule.
    avg_deg = sum(len(nei) for nei in adj) / n_nodes
    avg_vol = sum(f[3] for f in node_features) / n_nodes
    # simple rule: if avg_deg > 1.5 and avg_vol > 0.4 -> structural
    label = 1 if (avg_deg > 1.5 and avg_vol > 0.4) else 0
    return node_features, adj, label

def generate_dataset(n_samples=200):
    graphs = []
    labels = []
    for _ in range(n_samples):
        nf, adj, lbl = generate_bim_graph(0)  # label generated by rule
        graphs.append((nf, adj))
        labels.append(lbl)
    # split train/test
    split = int(0.8 * n_samples)
    train_graphs = graphs[:split]
    train_labels = labels[:split]
    test_graphs = graphs[split:]
    test_labels = labels[split:]
    return train_graphs, train_labels, test_graphs, test_labels

# ========================== ASCII Plotting ==========================
def ascii_plot(values, width=50, height=10, title="Loss"):
    """Simple ASCII line plot."""
    if not values:
        return
    minv, maxv = min(values), max(values)
    if maxv == minv:
        maxv = minv+1
    scale = (height-1) / (maxv - minv)
    plot = [[' ' for _ in range(width)] for _ in range(height)]
    # draw axes
    for y in range(height):
        plot[y][0] = '|'
    for x in range(width):
        plot[height-1][x] = '-'
    plot[height-1][0] = '+'
    # plot line
    step = max(1, len(values)//width)
    for i in range(width-1):
        idx1 = i * step
        if idx1 >= len(values): break
        idx2 = min(idx1 + step, len(values)-1)
        y1 = height-1 - int((values[idx1]-minv)*scale)
        y2 = height-1 - int((values[idx2]-minv)*scale)
        # draw segment
        if y1 < 0: y1=0; if y1>=height: y1=height-1
        if y2 < 0: y2=0; if y2>=height: y2=height-1
        if y1 == y2:
            plot[y1][i+1] = '-'
        else:
            # simple vertical line
            for y in range(min(y1,y2), max(y1,y2)+1):
                if 0 <= y < height:
                    plot[y][i+1] = '#'
    # print plot
    print(title)
    for row in plot:
        print(''.join(row))
    print(f"min: {minv:.4f}, max: {maxv:.4f}")

# ========================== Main Execution ==========================
def main():
    print("HyQuaBIM: Training on synthetic BIM data...")
    # Generate data
    train_graphs, train_labels, test_graphs, test_labels = generate_dataset(200)
    print(f"Train size: {len(train_graphs)}, Test size: {len(test_graphs)}")

    model = HyQuaBIM(node_feat_dim=5)
    epochs = 50
    lr = 0.05
    train_losses = []
    test_accs = []
    for epoch in range(epochs):
        # training
        total_loss = 0.0
        for (nf, adj), y in zip(train_graphs, train_labels):
            loss, prob = model.train_step(nf, adj, y, lr)
            total_loss += loss
        avg_loss = total_loss / len(train_graphs)
        train_losses.append(avg_loss)
        # test accuracy
        correct = 0
        for (nf, adj), y in zip(test_graphs, test_labels):
            prob, _, _ = model.forward(nf, adj)
            pred = 1 if prob > 0.5 else 0
            if pred == y:
                correct += 1
        test_acc = correct / len(test_graphs)
        test_accs.append(test_acc)
        if epoch % 10 == 0:
            print(f"Epoch {epoch}: loss={avg_loss:.4f}, test_acc={test_acc:.4f}")
    # final report
    print(f"Final test accuracy: {test_accs[-1]:.4f}")
    # ASCII plots
    ascii_plot(train_losses, title="Training Loss")
    ascii_plot(test_accs, title="Test Accuracy")

    # Display network architecture and quantum circuit (ASCII art)
    print("\n====== Network Architecture ======")
    print("""
    Input Graph -> Encoder (avg features) -> Linear -> Angles
         |                                          |
         v                                          v
    Classical Vector                          Quantum Circuit
         |                                          |
         +--------> Concatenate <-------------------+
                         |
                      Fusion (Linear)
                         |
                      Sigmoid -> Output
    """)
    print("\n====== Quantum Circuit (4 qubits) ======")
    print("""
    q0: ──RY(a)──●─────●───────●─────RY(p0)──╳──RY(p4)──┤ ⟨Z⟩
                  │     │       │              │
    q1: ──RY(b)──╳──●──╳──●────╳──RY(p1)──╳──RY(p5)──┤ ⟨Z⟩
                     │     │                   │
    q2: ──RY(c)──●──╳──●──╳──●──RY(p2)──╳──RY(p6)──┤ ⟨Z⟩
                  │           │              │
    q3: ──RY(d)──╳───────────╳──RY(p3)──╳──RY(p7)──┤ ⟨Z⟩

    Inputs a,b,c,d from encoder linear mapping.
    Parameters p0..p7 trained.
    """)
    print("Training completed. System fully operational.")

if __name__ == "__main__":
    main()
