# ========================== Matrix Utilities ==========================
def mat_mul(A, B):
    """Multiply two matrices A (m x n) and B (n x p) -> m x p."""
    m, n = len(A), len(A[0])
    n2, p = len(B), len(B[0])
    assert n == n2
    C = [[0.0]*p for _ in range(m)]
    for i in range(m):
        for k in range(n):
            aik = A[i][k]
            if aik != 0.0:
                for j in range(p):
                    C[i][j] += aik * B[k][j]
    return C

def mat_vec_mul(A, v):
    """Multiply matrix A by vector v, return vector."""
    m, n = len(A), len(A[0])
    assert n == len(v)
    return [sum(A[i][j] * v[j] for j in range(n)) for i in range(m)]

def mat_transpose(A):
    return list(map(list, zip(*A)))

def mat_add(A, B):
    return [[A[i][j] + B[i][j] for j in range(len(A[0]))] for i in range(len(A))]

def mat_scalar_mul(c, A):
    return [[c * x for x in row] for row in A]

def eye(n):
    return [[1.0 if i==j else 0.0 for j in range(n)] for i in range(n)]

def zeros_mat(m, n):
    return [[0.0]*n for _ in range(m)]

def vector_norm(v):
    return math.sqrt(sum(x*x for x in v))

# ========================== Classical Layers ==========================
class Linear:
    def __init__(self, in_features, out_features):
        # Xavier init
        limit = math.sqrt(6 / (in_features + out_features))
        self.W = [[random.uniform(-limit, limit) for _ in range(in_features)] for _ in range(out_features)]
        self.b = [0.0] * out_features
        self.in_features = in_features
        self.out_features = out_features
        self._cache = {}  # for backprop

    def forward(self, x):
        """x: vector of length in_features"""
        self._cache['x'] = x
        return [sum(self.W[i][j] * x[j] for j in range(self.in_features)) + self.b[i] for i in range(self.out_features)]

    def backward(self, grad_output):
        """grad_output: vector length out_features, returns grad_input, also saves gradients for parameters"""
        x = self._cache['x']
        # grad w.r.t input: W^T * grad_output
        grad_input = [0.0] * self.in_features
        for j in range(self.in_features):
            s = 0.0
            for i in range(self.out_features):
                s += self.W[i][j] * grad_output[i]
            grad_input[j] = s
        # grad w.r.t parameters
        self.grad_W = [[grad_output[i] * x[j] for j in range(self.in_features)] for i in range(self.out_features)]
        self.grad_b = grad_output[:]
        return grad_input

class ReLU:
    def forward(self, x):
        self._cache = x
        return [max(0.0, xi) for xi in x]

    def backward(self, grad_output):
        x = self._cache
        return [grad_output[i] if x[i] > 0 else 0.0 for i in range(len(x))]

