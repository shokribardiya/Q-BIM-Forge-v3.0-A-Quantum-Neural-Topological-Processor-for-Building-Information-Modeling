class SimpleEncoder:
    """Just average node features and global graph statistics."""
    def forward(self, node_features, adj):
        avg = [0.0]*len(node_features[0])
        for feat in node_features:
            for i in range(len(avg)):
                avg[i] += feat[i]
        n = len(node_features)
        avg = [x/n for x in avg]
        # Add degree stats
        degrees = [len(neighbors) for neighbors in adj]
        avg_deg = sum(degrees)/n
        # Add global clustering coefficient? For simplicity, just avg.
        # output vector: avg features + avg_deg
        return avg + [avg_deg]

# ========================== Full Model ==========================
class HyQuaBIM:
    def __init__(self, node_feat_dim=5):
        # node features: normalized x, y, z, volume, connectivity degree
        self.encoder = SimpleEncoder()
        enc_out_dim = node_feat_dim + 1  # + avg_deg
        # Map encoder output to 4 angles for quantum input
        self.to_quantum_input = Linear(enc_out_dim, 4)
        self.qcirc = QuantumCircuit4()
        # Fusion: combine quantum output (4 values) with classical features (same enc output) -> 1 output
        self.fusion = Linear(4 + enc_out_dim, 1)  # scalar logit

    def forward(self, node_features, adj):
        enc_vec = self.encoder.forward(node_features, adj)
        # Classical path: keep enc_vec
        # Quantum path: map to angles, pass through quantum layer
        angle_vec = self.to_quantum_input.forward(enc_vec)  # shape (4,)
        # bound angles to [0, 2π] by using tanh? Just use as is, wrapped.
        angle_vec = [math.atan(x) + math.pi/2 for x in angle_vec]  # map to (0,π) then adjust? We'll use sigmoid-like: (x/pi) mod 2pi.
        # Simpler: use sigmoid mapping: a = 2*math.pi * (1/(1+exp(-x))) to get (0,2pi)
        angle_vec = [2*math.pi / (1 + math.exp(-x)) for x in angle_vec]
        q_out = self.qcirc.forward(angle_vec)
        # Combine classical and quantum
        fusion_input = enc_vec + q_out  # length 6+4=10? Wait enc_out_dim=6, q_out=4, so total 10
        # Actually enc_out_dim=5+1=6, so concatenate: enc_vec (6) + q_out (4) = 10
        combined = enc_vec + q_out
        logit = self.fusion.forward(combined)[0]
        # sigmoid probability
        prob = 1/(1 + math.exp(-logit))
        return prob, logit, (enc_vec, q_out, angle_vec)

    def compute_loss(self, y_true, prob):
        """Binary cross-entropy loss."""
        eps = 1e-7
        return - (y_true * math.log(prob+eps) + (1-y_true) * math.log(1-prob+eps))

    def train_step(self, node_features, adj, y_true, lr=0.01):
        # forward
        prob, logit, cache = self.forward(node_features, adj)
        loss = self.compute_loss(y_true, prob)
        # backprop
        # dL/dlogit
        d_logit = prob - y_true  # derivative of BCE with sigmoid
        # gradient for fusion layer
        combined = cache[0] + cache[1]  # enc_vec + q_out
        grad_fusion_input = self.fusion.backward([d_logit])  # returns gradient w.r.t combined input (list len 10)
        # split gradient to classical and quantum parts
        enc_dim = len(cache[0])
        grad_enc_vec = grad_fusion_input[:enc_dim]
        grad_q_out = grad_fusion_input[enc_dim:]
        # backprop through quantum circuit
        grad_angles = self.qcirc.backward(grad_q_out, cache[2])
        # backprop through to_quantum_input linear
        grad_to_quantum = self.to_quantum_input.backward(grad_angles)
        # encoder is not parameterized, ignore gradient
        # Update parameters: fusion, to_quantum_input, quantum params
        # SGD
        for name, layer in [('fusion', self.fusion), ('to_quantum', self.to_quantum_input)]:
            lr_local = lr
            for i in range(layer.out_features):
                layer.b[i] -= lr_local * layer.grad_b[i]
                for j in range(layer.in_features):
                    layer.W[i][j] -= lr_local * layer.grad_W[i][j]
        # update quantum params
        for i in range(8):
            self.qcirc.params[i] -= lr * self.qcirc.grad[i]
        return loss, prob

