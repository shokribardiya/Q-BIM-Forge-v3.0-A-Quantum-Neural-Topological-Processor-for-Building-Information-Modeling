# Because implementing the full two-qubit gate application generically with tensor products is tricky,
# I'll instead use the fact that for n_qubits=4, we can precompute the full gate matrix for each two-qubit operation
# by using the Kronecker product: we can write a function kron(*matrices) that computes tensor product of multiple matrices in sequence.
# Then for CNOT on control c and target t, we build list of n_qubits matrices, each I except positions c and t which form a 4x4 CNOT,
# but the CNOT acts on two qubits so we need to combine them into one 4x4 matrix placed at the correct tensor factor.
# This is doable.

def kron(*matrices):
    """Compute Kronecker product of a sequence of matrices."""
    result = [[1.0]]
    for mat in matrices:
        # result (r1 x c1), mat (r2 x c2) -> (r1*r2 x c1*c2)
        r1, c1 = len(result), len(result[0])
        r2, c2 = len(mat), len(mat[0])
        new = [[0.0]*(c1*c2) for _ in range(r1*r2)]
        for i in range(r1):
            for j in range(c1):
                val = result[i][j]
                if val != 0.0:
                    for k in range(r2):
                        for l in range(c2):
                            new[i*r2 + k][j*c2 + l] = val * mat[k][l]
        result = new
    return result

