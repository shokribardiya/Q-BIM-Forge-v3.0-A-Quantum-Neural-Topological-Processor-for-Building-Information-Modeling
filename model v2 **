# HYPERGRAPH ATTENTION ENCODER (Classical)
# ============================================================================
class HypergraphAttentionEncoder:
    """
    Advanced hypergraph neural network with multi-head attention.
    BIM data naturally forms hypergraphs (e.g., a wall connects to
    multiple slabs, beams, and columns simultaneously).
    """

    def __init__(self, node_feat_dim: int, hidden_dim: int,
                 n_heads: int = 8, n_layers: int = 3):
        self.node_feat_dim = node_feat_dim
        self.hidden_dim = hidden_dim
        self.n_heads = n_heads
        self.n_layers = n_layers
        self.head_dim = hidden_dim // n_heads

        # Layer parameters
        self.W_q = [Tensor.randn(hidden_dim, hidden_dim) for _ in range(n_layers)]
        self.W_k = [Tensor.randn(hidden_dim, hidden_dim) for _ in range(n_layers)]
        self.W_v = [Tensor.randn(hidden_dim, hidden_dim) for _ in range(n_layers)]
        self.W_o = [Tensor.randn(hidden_dim, hidden_dim) for _ in range(n_layers)]

        # Input projection
        self.W_in = Tensor.randn(node_feat_dim, hidden_dim)
        self.b_in = Tensor.randn(hidden_dim)

        # Layer normalization parameters
        self.ln_gamma = [Tensor.randn(hidden_dim) for _ in range(n_layers)]
        self.ln_beta = [Tensor.randn(hidden_dim) for _ in range(n_layers)]

        # Residual connection scaling
        self.res_scale = [1.0] * n_layers

    def _layer_norm(self, x: List[float], gamma: List[float],
                    beta: List[float]) -> List[float]:
        """Layer normalization."""
        n = len(x)
        mean = sum(x) / n
        var = sum((xi - mean) ** 2 for xi in x) / n
        std = math.sqrt(var + GlobalConfig.EPSILON)
        return [gamma[i] * (x[i] - mean) / std + beta[i] for i in range(n)]

    def _multi_head_attention(self, query: List[float],
                              keys: List[List[float]],
                              values: List[List[float]],
                              layer_idx: int) -> List[float]:
        """Multi-head self-attention mechanism."""
        d = self.hidden_dim
        h = self.n_heads
        dh = self.head_dim

        Wq, Wk, Wv, Wo = self.W_q[layer_idx], self.W_k[layer_idx], \
                          self.W_v[layer_idx], self.W_o[layer_idx]

        # Project query
        q_proj = [sum(Wq[i][j] * query[j] for j in range(d)) for i in range(d)]

        n_keys = len(keys)
        all_head_outputs = []

        for head in range(h):
            head_start = head * dh
            head_end = head_start + dh

            # Compute attention scores
            scores = []
            for ki in range(n_keys):
                k_proj = [sum(Wk[i][j] * keys[ki][j] for j in range(d))
                         for i in range(d)]
                score = sum(q_proj[j] * k_proj[j]
                           for j in range(head_start, head_end))
                score /= math.sqrt(dh)
                scores.append(score)

            # Softmax
            max_score = max(scores) if scores else 0.0
            exp_scores = [math.exp(s - max_score) for s in scores]
            sum_exp = sum(exp_scores) + GlobalConfig.EPSILON
            attn_weights = [e / sum_exp for e in exp_scores]

            # Weighted sum of values
            head_out = [0.0] * dh
            for ki in range(n_keys):
                v_proj = [sum(Wv[i][j] * values[ki][j] for j in range(d))
                         for i in range(d)]
                for j in range(dh):
                    head_out[j] += attn_weights[ki] * v_proj[head_start + j]

            all_head_outputs.extend(head_out)

        # Output projection
        output = [sum(Wo[i][j] * all_head_outputs[j] for j in range(d))
                 for i in range(d)]
        return output

    def forward(self, node_features: List[List[float]],
                hyperedges: List[List[int]]) -> List[List[float]]:
        """
        Forward pass through hypergraph attention encoder.
        node_features: [n_nodes × feat_dim]
        hyperedges: list of hyperedges, each is list of node indices
        Returns: enriched node embeddings [n_nodes × hidden_dim]
        """
        n_nodes = len(node_features)
        d = self.hidden_dim

        # Input projection
        node_embeddings = []
        for feat in node_features:
            emb = [self.b_in[j] + sum(self.W_in[i][j] * feat[i]
                                      for i in range(self.node_feat_dim))
                   for j in range(d)]
            # GELU activation
            emb = [Activation.gelu(e) for e in emb]
            node_embeddings.append(emb)

        # Multi-layer processing
        for layer in range(self.n_layers):
            new_embeddings = []

            for node_idx in range(n_nodes):
                # Find hyperedges containing this node
                incident_hyperedges = []
                for he_idx, he in enumerate(hyperedges):
                    if node_idx in he:
                        incident_hyperedges.append(he_idx)

                # Collect neighbor representations
                neighbor_embs = []
                for he_idx in incident_hyperedges:
                    for neighbor in hyperedges[he_idx]:
                        if neighbor != node_idx:
                            neighbor_embs.append(node_embeddings[neighbor])

                if not neighbor_embs:
                    neighbor_embs = [node_embeddings[node_idx]]

                # Multi-head attention
                attn_out = self._multi_head_attention(
                    node_embeddings[node_idx],
                    neighbor_embs,
                    neighbor_embs,
                    layer
                )

                # Residual connection + layer norm
                residual = [node_embeddings[node_idx][j] +
                           self.res_scale[layer] * attn_out[j]
                           for j in range(d)]
                normed = self._layer_norm(residual, self.ln_gamma[layer],
                                         self.ln_beta[layer])

                # Activation
                activated = [Activation.swish(n) for n in normed]
                new_embeddings.append(activated)

            node_embeddings = new_embeddings

        return node_embeddings

