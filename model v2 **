# ADVANCED BIM DATA GENERATOR
# ============================================================================
class BIMDataGenerator:
    """
    Generates realistic synthetic BIM graph data for training and testing.
    Simulates building elements with realistic spatial and relational properties.
    """

    def __init__(self, seed: int = 42):
        random.seed(seed)
        self.element_types = [
            'Wall_Structural', 'Wall_NonStructural', 'Column', 'Beam',
            'Slab', 'Foundation', 'Door', 'Window', 'Stair', 'Ramp',
            'CurtainWall', 'Railing', 'Pipe', 'Duct', 'CableTray'
        ]

    def generate_graph(self, n_nodes: int = None) -> Tuple[List[List[float]],
                                                            List[List[int]], int]:
        """
        Generate a single BIM graph.
        Returns: (node_features, hyperedges, label)
        """
        if n_nodes is None:
            n_nodes = random.randint(8, 25)

        # Generate nodes with rich features
        node_features = []
        for _ in range(n_nodes):
            # Spatial coordinates
            x = random.uniform(0, 50)
            y = random.uniform(0, 30)
            z = random.uniform(0, 20)

            # Geometric properties
            length = random.uniform(0.5, 10)
            width = random.uniform(0.1, 2)
            height = random.uniform(0.5, 15)
            volume = length * width * height
            surface_area = 2 * (length * width + length * height + width * height)

            # Structural properties
            element_type_idx = random.randint(0, len(self.element_types) - 1)
            is_structural = 1.0 if element_type_idx < 6 else 0.0
            material_density = random.uniform(500, 2500) if is_structural else \
                              random.uniform(100, 800)

            # Connectivity indicators
            n_connections_estimate = random.randint(0, 8)

            # Feature vector: 12 dimensions
            features = [
                x / 50.0, y / 30.0, z / 20.0,  # normalized position
                length / 10.0, width / 2.0, height / 15.0,  # dimensions
                volume / 300.0, surface_area / 300.0,  # derived
                is_structural, material_density / 2500.0,  # structural
                n_connections_estimate / 8.0,  # connectivity
                math.sin(x * y * 0.01)  # nonlinear interaction feature
            ]
            node_features.append(features)

        # Generate hyperedges (BIM relationships)
        hyperedges = []
        # Spatial proximity hyperedges
        for i in range(n_nodes):
            for j in range(i + 1, n_nodes):
                dist = math.sqrt(
                    (node_features[i][0] - node_features[j][0]) ** 2 +
                    (node_features[i][1] - node_features[j][1]) ** 2 +
                    (node_features[i][2] - node_features[j][2]) ** 2
                )
                if dist < 0.15:  # proximity threshold
                    # Create hyperedge with up to 4 nodes
                    nearby = [i, j]
                    for k in range(n_nodes):
                        if k != i and k != j and len(nearby) < 4:
                            dist_k = math.sqrt(
                                (node_features[i][0] - node_features[k][0]) ** 2 +
                                (node_features[i][1] - node_features[k][1]) ** 2 +
                                (node_features[i][2] - node_features[k][2]) ** 2
                            )
                            if dist_k < 0.2:
                                nearby.append(k)
                    if len(nearby) >= 2:
                        hyperedges.append(nearby)

        # Ensure at least some hyperedges
        if len(hyperedges) == 0:
            for i in range(0, n_nodes - 1, 2):
                hyperedges.append([i, i + 1])

        # Label: structural integrity classification
        structural_count = sum(1 for f in node_features if f[8] > 0.5)
        structural_ratio = structural_count / n_nodes
        avg_volume = sum(f[6] for f in node_features) / n_nodes
        avg_connections = sum(f[10] for f in node_features) / n_nodes

        # Complex labeling rule
        label = 1 if (structural_ratio > 0.3 and avg_volume > 0.2 and
                     avg_connections > 0.3) else 0

        return node_features, hyperedges, label

    def generate_dataset(self, n_samples: int) -> Tuple[List, List, List, List, List, List]:
        """Generate full dataset with train/val/test splits."""
        all_graphs = []
        all_labels = []

        for _ in range(n_samples):
            nf, he, lbl = self.generate_graph()
            all_graphs.append((nf, he))
            all_labels.append(lbl)

        # Split
        n_train = int(0.7 * n_samples)
        n_val = int(0.15 * n_samples)

        indices = list(range(n_samples))
        random.shuffle(indices)

        train_idx = indices[:n_train]
        val_idx = indices[n_train:n_train + n_val]
        test_idx = indices[n_train + n_val:]

        train_graphs = [all_graphs[i] for i in train_idx]
        train_labels = [all_labels[i] for i in train_idx]
        val_graphs = [all_graphs[i] for i in val_idx]
        val_labels = [all_labels[i] for i in val_idx]
        test_graphs = [all_graphs[i] for i in test_idx]
        test_labels = [all_labels[i] for i in test_idx]

        return train_graphs, train_labels, val_graphs, val_labels, test_graphs, test_labels

