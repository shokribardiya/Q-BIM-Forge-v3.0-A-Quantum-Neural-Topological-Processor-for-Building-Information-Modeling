# ============================================================================
class Activation:
    """Collection of advanced activation functions with caching for backprop."""

    @staticmethod
    def gelu(x: float) -> float:
        """Gaussian Error Linear Unit."""
        return 0.5 * x * (1.0 + math.tanh(
            math.sqrt(2.0 / math.pi) * (x + 0.044715 * x ** 3)))

    @staticmethod
    def gelu_derivative(x: float) -> float:
        """Derivative of GELU."""
        cdf = 0.5 * (1.0 + math.erf(x / math.sqrt(2.0)))
        pdf = math.exp(-0.5 * x * x) / math.sqrt(2.0 * math.pi)
        return cdf + x * pdf

    @staticmethod
    def swish(x: float, beta: float = 1.0) -> float:
        """Swish (SiLU) activation."""
        return x / (1.0 + math.exp(-beta * x))

    @staticmethod
    def swish_derivative(x: float, beta: float = 1.0) -> float:
        """Derivative of Swish."""
        sig = 1.0 / (1.0 + math.exp(-beta * x))
        return sig + beta * x * sig * (1.0 - sig)

    @staticmethod
    def mish(x: float) -> float:
        """Mish activation."""
        return x * math.tanh(math.log(1.0 + math.exp(x)))

    @staticmethod
    def relu(x: float) -> float:
        return max(0.0, x)

    @staticmethod
    def leaky_relu(x: float, alpha: float = 0.01) -> float:
        return x if x > 0 else alpha * x

    @staticmethod
    def sigmoid(x: float) -> float:
        if x > 20: return 1.0
        if x < -20: return 0.0
        return 1.0 / (1.0 + math.exp(-x))

    @staticmethod
    def tanh(x: float) -> float:
        if x > 20: return 1.0
        if x < -20: return -1.0
        return math.tanh(x)

