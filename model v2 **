# UTILITY FUNCTIONS - Pure Python Linear Algebra Library
# ============================================================================
class Tensor:
    """
    A comprehensive tensor library built from scratch.
    Supports: reshape, transpose, matmul, element-wise ops, broadcasting.
    This replaces NumPy entirely.
    """

    @staticmethod
    def zeros(*shape: int) -> List:
        """Create a nested list of zeros with given shape."""
        if len(shape) == 0:
            return 0.0
        if len(shape) == 1:
            return [0.0] * shape[0]
        return [Tensor.zeros(*shape[1:]) for _ in range(shape[0])]

    @staticmethod
    def ones(*shape: int) -> List:
        """Create nested list of ones."""
        if len(shape) == 0:
            return 1.0
        if len(shape) == 1:
            return [1.0] * shape[0]
        return [Tensor.ones(*shape[1:]) for _ in range(shape[0])]

    @staticmethod
    def randn(*shape: int) -> List:
        """Random normal (Box-Muller) nested list."""
        def _box_muller() -> float:
            u1 = random.random()
            u2 = random.random()
            if u1 == 0:
                u1 = 1e-10
            return math.sqrt(-2.0 * math.log(u1)) * math.cos(2.0 * math.pi * u2)

        if len(shape) == 0:
            return _box_muller()
        if len(shape) == 1:
            return [_box_muller() for _ in range(shape[0])]
        return [Tensor.randn(*shape[1:]) for _ in range(shape[0])]

    @staticmethod
    def rand(*shape: int) -> List:
        """Random uniform [0,1]."""
        if len(shape) == 0:
            return random.random()
        if len(shape) == 1:
            return [random.random() for _ in range(shape[0])]
        return [Tensor.rand(*shape[1:]) for _ in range(shape[0])]

    @staticmethod
    def randu(*shape: int, low: float = -1.0, high: float = 1.0) -> List:
        """Random uniform in range [low, high]."""
        if len(shape) == 0:
            return random.uniform(low, high)
        if len(shape) == 1:
            return [random.uniform(low, high) for _ in range(shape[0])]
        return [Tensor.randu(*shape[1:], low=low, high=high) for _ in range(shape[0])]

    @staticmethod
    def shape(tensor: Any) -> Tuple[int, ...]:
        """Return shape of nested list tensor."""
        if not isinstance(tensor, list):
            return ()
        if len(tensor) == 0:
            return (0,)
        inner = Tensor.shape(tensor[0])
        return (len(tensor),) + inner

    @staticmethod
    def reshape(tensor: List, new_shape: Tuple[int, ...]) -> List:
        """Reshape tensor by flattening and rebuilding."""
        flat = Tensor._flatten(tensor)
        total = 1
        for s in new_shape:
            total *= s
        if len(flat) != total:
            raise ValueError(f"Cannot reshape: {len(flat)} vs {total}")
        return Tensor._build(flat, new_shape)

    @staticmethod
    def _flatten(tensor: Any) -> List:
        if not isinstance(tensor, list):
            return [tensor]
        result = []
        for item in tensor:
            result.extend(Tensor._flatten(item))
        return result

    @staticmethod
    def _build(flat: List, shape: Tuple[int, ...]) -> List:
        if len(shape) == 0:
            return flat[0]
        if len(shape) == 1:
            return flat[:shape[0]]
        stride = 1
        for s in shape[1:]:
            stride *= s
        return [Tensor._build(flat[i*stride:(i+1)*stride], shape[1:])
                for i in range(shape[0])]

    @staticmethod
    def matmul(A: List, B: List) -> List:
        """Matrix multiplication for 2D tensors."""
        m, k = len(A), len(A[0])
        k2, n = len(B), len(B[0])
        if k != k2:
            raise ValueError(f"Shape mismatch: ({m},{k}) x ({k2},{n})")
        C = [[0.0] * n for _ in range(m)]
        for i in range(m):
            Ai = A[i]
            Ci = C[i]
            for p in range(k):
                aip = Ai[p]
                if aip != 0.0:
                    Bp = B[p]
                    for j in range(n):
                        Ci[j] += aip * Bp[j]
        return C

    @staticmethod
    def transpose(A: List) -> List:
        """Transpose 2D matrix."""
        if not isinstance(A[0], list):
            return [[a] for a in A]
        return [[A[i][j] for i in range(len(A))] for j in range(len(A[0]))]

    @staticmethod
    def add(A: Any, B: Any) -> Any:
        """Element-wise addition with broadcasting."""
        if not isinstance(A, list) and not isinstance(B, list):
            return A + B
        if isinstance(A, list) and isinstance(B, list):
            if len(A) != len(B):
                raise ValueError("Broadcasting not fully supported")
            return [Tensor.add(a, b) for a, b in zip(A, B)]
        raise ValueError("Cannot add scalar to tensor in generic way")

    @staticmethod
    def mul(A: Any, B: Any) -> Any:
        """Element-wise multiplication."""
        if not isinstance(A, list) and not isinstance(B, list):
            return A * B
        if isinstance(A, list) and isinstance(B, list):
            return [Tensor.mul(a, b) for a, b in zip(A, B)]
        if isinstance(A, list):
            return [Tensor.mul(a, B) for a in A]
        return [Tensor.mul(A, b) for b in B]

    @staticmethod
    def scalar_mul(c: float, A: Any) -> Any:
        """Multiply by scalar."""
        if not isinstance(A, list):
            return c * A
        return [Tensor.scalar_mul(c, a) for a in A]

    @staticmethod
    def sum_all(tensor: Any) -> float:
        """Sum all elements."""
        if not isinstance(tensor, list):
            return tensor
        return sum(Tensor.sum_all(t) for t in tensor)

    @staticmethod
    def mean(tensor: List, axis: int = -1) -> Any:
        """Mean along axis."""
        if axis == -1:
            flat = Tensor._flatten(tensor)
            return sum(flat) / len(flat)
        raise NotImplementedError("Axis-specific mean")

    @staticmethod
    def std(tensor: List) -> float:
        """Standard deviation of flattened tensor."""
        flat = Tensor._flatten(tensor)
        n = len(flat)
        mean = sum(flat) / n
        var = sum((x - mean) ** 2 for x in flat) / n
        return math.sqrt(var)

    @staticmethod
    def clip(tensor: List, min_val: float, max_val: float) -> List:
        """Clip values."""
        if not isinstance(tensor, list):
            return max(min_val, min(max_val, tensor))
        return [Tensor.clip(t, min_val, max_val) for t in tensor]

    @staticmethod
    def eye(n: int) -> List:
        """Identity matrix."""
        return [[1.0 if i == j else 0.0 for j in range(n)] for i in range(n)]

    @staticmethod
    def diag(v: List) -> List:
        """Diagonal matrix from vector."""
        n = len(v)
        return [[v[i] if i == j else 0.0 for j in range(n)] for i in range(n)]

