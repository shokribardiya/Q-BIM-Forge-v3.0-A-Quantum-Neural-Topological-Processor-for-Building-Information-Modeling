# QUANTUM-CLASSICAL FUSION MODULE
# ============================================================================
class QuantumClassicalFusion:
    """
    Adaptive fusion module that learns to weight classical and quantum
    predictions based on input uncertainty.
    Implements a gating mechanism with uncertainty estimation.
    """

    def __init__(self, classical_dim: int, quantum_dim: int):
        self.classical_dim = classical_dim
        self.quantum_dim = quantum_dim
        combined_dim = classical_dim + quantum_dim

        # Gating network
        self.W_gate = Tensor.randn(combined_dim, 2)
        self.b_gate = Tensor.randn(2)

        # Fusion weights
        self.W_fusion = Tensor.randn(combined_dim, combined_dim)
        self.b_fusion = Tensor.randn(combined_dim)

        # Uncertainty head
        self.W_uncertainty = Tensor.randn(combined_dim, 1)
        self.b_uncertainty = Tensor.randn(1)

    def forward(self, classical_features: List[float],
                quantum_features: List[float]) -> Tuple[List[float], float]:
        """
        Fuse classical and quantum features with learned gating.
        Returns: (fused_features, uncertainty_estimate)
        """
        combined = classical_features + quantum_features
        cd = len(combined)

        # Compute gate values
        gate_logits = [self.b_gate[i] + sum(self.W_gate[j][i] * combined[j]
                                            for j in range(cd))
                      for i in range(2)]
        gate = [math.exp(g) for g in gate_logits]
        gate_sum = gate[0] + gate[1]
        gate = [g / gate_sum for g in gate]

        # Weighted fusion
        weighted_classical = [gate[0] * c for c in classical_features]
        weighted_quantum = [gate[1] * q for q in quantum_features]
        weighted_combined = weighted_classical + weighted_quantum

        # Final fusion transformation
        fused = [self.b_fusion[i] + sum(self.W_fusion[j][i] * weighted_combined[j]
                                        for j in range(cd))
                for i in range(cd)]
        fused = [Activation.swish(f) for f in fused]

        # Uncertainty estimate
        uncertainty_raw = self.b_uncertainty[0]
        for j in range(cd):
            uncertainty_raw += self.W_uncertainty[j][0] * combined[j]
        uncertainty = Activation.sigmoid(uncertainty_raw)

        return fused, uncertainty

# ============================================================================
# HIERARCHICAL READOUT WITH AUXILIARY LOSSES
# ============================================================================
class HierarchicalReadout:
    """
    Multi-level readout head with auxiliary losses at each level.
    Inspired by GoogLeNet/Inception auxiliary classifiers.
    """

    def __init__(self, input_dim: int, hidden_dim: int, n_classes: int,
                 n_levels: int = 3):
        self.input_dim = input_dim
        self.hidden_dim = hidden_dim
        self.n_classes = n_classes
        self.n_levels = n_levels

        # Each level has its own classifier
        self.W_levels = []
        self.b_levels = []
        for lvl in range(n_levels):
            self.W_levels.append(Tensor.randn(input_dim, n_classes))
            self.b_levels.append(Tensor.randn(n_classes))

        # Final fusion classifier
        self.W_final = Tensor.randn(input_dim * n_levels, n_classes)
        self.b_final = Tensor.randn(n_classes)

        # Level importance weights (learnable)
        self.level_weights = [1.0 / n_levels] * n_levels

    def forward(self, features: List[float]) -> Tuple[List[float], List[List[float]]]:
        """
        Forward pass returning final logits and auxiliary logits.
        """
        d = self.input_dim
        aux_logits = []

        for lvl in range(self.n_levels):
            logits = [self.b_levels[lvl][c] +
                     sum(self.W_levels[lvl][i][c] * features[i] for i in range(d))
                     for c in range(self.n_classes)]
            aux_logits.append(logits)

        # Final: weighted combination of all levels
        final_logits = [0.0] * self.n_classes
        for lvl in range(self.n_levels):
            w = self.level_weights[lvl]
            for c in range(self.n_classes):
                final_logits[c] += w * aux_logits[lvl][c]

        return final_logits, aux_logits

    def compute_total_loss(self, final_logits: List[float],
                          aux_logits: List[List[float]],
                          target: int,
                          aux_weight: float = 0.3) -> float:
        """Compute combined loss with auxiliary classifiers."""
        # Main loss
        main_loss = self._cross_entropy(final_logits, target)

        # Auxiliary losses
        aux_loss = 0.0
        for logits in aux_logits:
            aux_loss += self._cross_entropy(logits, target)
        aux_loss /= len(aux_logits)

        return main_loss + aux_weight * aux_loss

    def _cross_entropy(self, logits: List[float], target: int) -> float:
        """Cross-entropy loss."""
        max_logit = max(logits)
        exp_sum = sum(math.exp(l - max_logit) for l in logits)
        log_prob = logits[target] - max_logit - math.log(exp_sum + GlobalConfig.EPSILON)
        return -log_prob

# ============================================================================
# QUANTUM GENERATIVE AUGMENTATION
# ============================================================================
class QuantumGenerativeAugmenter:
    """
    Quantum Circuit Born Machine for generating synthetic BIM samples.
    Addresses data scarcity in BIM applications.
    """

    def __init__(self, feature_dim: int, n_qubits: int = 8):
        self.feature_dim = feature_dim
        self.n_qubits = n_qubits
        self.qcbm = DeepVariationalQuantumCircuit(n_qubits, n_layers=3)
        # Classical decoder: quantum samples → BIM features
        self.decoder_W = Tensor.randn(2 ** n_qubits, feature_dim)
        self.decoder_b = Tensor.randn(feature_dim)

    def generate_samples(self, n_samples: int) -> List[List[float]]:
        """Generate synthetic BIM feature vectors."""
        samples = []
        dummy_features = [random.uniform(-math.pi, math.pi)
                         for _ in range(self.n_qubits)]

        for _ in range(n_samples):
            qstate, _ = self.qcbm.forward(dummy_features)
            # Sample from Born machine
            bitstring = qstate.sample(1)[0]

            # Decode to feature space
            features = [self.decoder_b[j] +
                       self.decoder_W[bitstring][j]
                       for j in range(self.feature_dim)]
            features = [Activation.tanh(f) for f in features]
            samples.append(features)

        return samples

# ============================================================================
# COMPLETE Q-BIM FORGE MODEL
# ============================================================================
class QBIMForge:
    """
    The complete Q-BIM Forge model integrating all components:

    1. Hypergraph Attention Encoder (classical)
    2. Quantum Deep Equilibrium Message Passing (Q-DEMP)
    3. Deep Variational Quantum Circuit
    4. Quantum-Classical Fusion with uncertainty
    5. Hierarchical Readout with auxiliary losses
    6. Quantum Generative Augmentation (for data-scarce scenarios)
    """

    def __init__(self, config: GlobalConfig = None):
        if config is None:
            config = GlobalConfig()
        self.cfg = config

        # Classical encoder
        self.encoder = HypergraphAttentionEncoder(
            node_feat_dim=config.NODE_FEAT_DIM,
            hidden_dim=config.HIDDEN_DIM,
            n_heads=config.N_ATTENTION_HEADS,
            n_layers=config.N_HYPERGRAPH_LAYERS
        )

        # Quantum Deep Equilibrium
        self.q_demp = QuantumDeepEquilibriumMessagePassing(
            hidden_dim=config.EMBEDDING_DIM,
            n_qubits=config.N_QUBITS
        )

        # Variational Quantum Circuit
        self.vqc = DeepVariationalQuantumCircuit(
            n_qubits=config.N_QUBITS,
            n_layers=config.Q_LAYERS
        )

        # Quantum feature map
        self.q_feature_map = QuantumFeatureMap(
            input_dim=config.EMBEDDING_DIM,
            n_qubits=config.N_QUBITS
        )

        # Fusion module
        self.fusion = QuantumClassicalFusion(
            classical_dim=config.EMBEDDING_DIM,
            quantum_dim=config.N_QUBITS + (config.N_QUBITS * (config.N_QUBITS - 1)) // 2
        )

        # Readout
        self.readout = HierarchicalReadout(
            input_dim=config.EMBEDDING_DIM + config.N_QUBITS +
                     (config.N_QUBITS * (config.N_QUBITS - 1)) // 2,
            hidden_dim=config.HIDDEN_DIM // 2,
            n_classes=2  # binary classification for BIM elements
        )

        # Generative augmenter
        self.augmenter = QuantumGenerativeAugmenter(
            feature_dim=config.NODE_FEAT_DIM,
            n_qubits=config.N_QUBITS
        )

    def forward(self, node_features: List[List[float]],
                hyperedges: List[List[int]],
                global_context: Optional[List[float]] = None) -> Dict[str, Any]:
        """
        Complete forward pass through Q-BIM Forge.

        Args:
            node_features: [n_nodes × NODE_FEAT_DIM] BIM element features
            hyperedges: list of hyperedges connecting nodes
            global_context: optional global graph features

        Returns:
            Dictionary containing all intermediate and final outputs
        """
        n_nodes = len(node_features)

        # 1. Classical Hypergraph Encoding
        node_embeddings = self.encoder.forward(node_features, hyperedges)

        # 2. Global pooling for graph-level representation
        global_emb = [0.0] * self.cfg.EMBEDDING_DIM
        for emb in node_embeddings:
            for j in range(self.cfg.EMBEDDING_DIM):
                global_emb[j] += emb[j]
        for j in range(self.cfg.EMBEDDING_DIM):
            global_emb[j] /= n_nodes

        # 3. Quantum Deep Equilibrium
        if global_context is None:
            global_context = global_emb

        z_star, deq_iterations = self.q_demp.solve_fixed_point(
            global_context, z_init=global_emb
        )

        # 4. Quantum Feature Map & VQC
        q_angles = self.q_feature_map.map_to_angles(z_star)
        qstate, q_expectations = self.vqc.forward(q_angles)

        # 5. Quantum-Classical Fusion
        fused_features, uncertainty = self.fusion.forward(z_star, q_expectations)

        # 6. Hierarchical Readout
        final_logits, aux_logits = self.readout.forward(fused_features)

        return {
            'node_embeddings': node_embeddings,
            'global_embedding': global_emb,
            'equilibrium_state': z_star,
            'deq_iterations': deq_iterations,
            'quantum_expectations': q_expectations,
            'quantum_state': qstate,
            'fused_features': fused_features,
            'uncertainty': uncertainty,
            'final_logits': final_logits,
            'aux_logits': aux_logits
        }

    def train_step(self, node_features: List[List[float]],
                   hyperedges: List[List[int]],
                   target: int,
                   learning_rate: float = 0.001) -> Tuple[float, Dict]:
        """Single training step with gradient computation."""
        # Forward pass
        output = self.forward(node_features, hyperedges)

        # Compute loss
        total_loss = self.readout.compute_total_loss(
            output['final_logits'],
            output['aux_logits'],
            target
        )

        # Gradient computation and parameter updates
        # (Full backpropagation through all components)
        # This is a simplified gradient update; production version
        # would implement full automatic differentiation.

        # Update quantum circuit parameters via parameter-shift
        q_grads = self.vqc.get_all_gradients(
            self.q_feature_map.map_to_angles(output['equilibrium_state'])
        )

        # Apply gradients (simplified SGD)
        for idx in range(len(self.vqc.params)):
            # Average gradient across all expectation values
            avg_grad = sum(q_grads[idx]) / len(q_grads[idx])
            self.vqc.params[idx] -= learning_rate * avg_grad

        return total_loss, output

    def predict(self, node_features: List[List[float]],
                hyperedges: List[List[int]]) -> Tuple[int, float, float]:
        """Make prediction with uncertainty."""
        output = self.forward(node_features, hyperedges)
        logits = output['final_logits']

        # Softmax probabilities
        max_logit = max(logits)
        exp_logits = [math.exp(l - max_logit) for l in logits]
        sum_exp = sum(exp_logits)
        probs = [e / sum_exp for e in exp_logits]

        predicted_class = max(range(len(probs)), key=lambda i: probs[i])
        confidence = probs[predicted_class]
        uncertainty = output['uncertainty']

        return predicted_class, confidence, uncertainty

