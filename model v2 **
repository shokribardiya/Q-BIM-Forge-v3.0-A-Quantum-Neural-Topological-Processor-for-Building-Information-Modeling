# TRAINING ENGINE WITH ADVANCED FEATURES
# ============================================================================
class TrainingEngine:
    """
    Advanced training engine with:
    - Cosine annealing learning rate schedule
    - Gradient clipping
    - Early stopping
    - Model checkpointing
    - Comprehensive metrics tracking
    """

    def __init__(self, model: QBIMForge, config: GlobalConfig):
        self.model = model
        self.cfg = config
        self.history = {
            'train_loss': [], 'val_loss': [], 'test_accuracy': [],
            'train_accuracy': [], 'val_accuracy': [],
            'learning_rates': [], 'quantum_grad_norms': [],
            'deq_iterations': [], 'uncertainties': []
        }

    def cosine_annealing_lr(self, epoch: int, base_lr: float,
                           min_lr: float = 1e-6) -> float:
        """Cosine annealing learning rate schedule."""
        return min_lr + 0.5 * (base_lr - min_lr) * \
               (1 + math.cos(math.pi * epoch / self.cfg.N_EPOCHS))

    def train_epoch(self, graphs: List, labels: List,
                    lr: float) -> Tuple[float, float]:
        """Train for one epoch."""
        total_loss = 0.0
        correct = 0
        n_samples = len(graphs)

        indices = list(range(n_samples))
        random.shuffle(indices)

        for idx in indices:
            nf, he = graphs[idx]
            target = labels[idx]

            loss, output = self.model.train_step(nf, he, target, lr)
            total_loss += loss

            # Accuracy
            pred_class = max(range(len(output['final_logits'])),
                           key=lambda i: output['final_logits'][i])
            if pred_class == target:
                correct += 1

            # Track metrics
            self.history['deq_iterations'].append(output['deq_iterations'])
            self.history['uncertainties'].append(output['uncertainty'])

        avg_loss = total_loss / n_samples
        accuracy = correct / n_samples

        return avg_loss, accuracy

    def evaluate(self, graphs: List, labels: List) -> Tuple[float, float]:
        """Evaluate model on a dataset."""
        total_loss = 0.0
        correct = 0
        n_samples = len(graphs)

        for idx in range(n_samples):
            nf, he = graphs[idx]
            target = labels[idx]

            output = self.model.forward(nf, he)

            # Loss
            loss = self.model.readout.compute_total_loss(
                output['final_logits'], output['aux_logits'], target
            )
            total_loss += loss

            # Accuracy
            pred_class = max(range(len(output['final_logits'])),
                           key=lambda i: output['final_logits'][i])
            if pred_class == target:
                correct += 1

        avg_loss = total_loss / n_samples
        accuracy = correct / n_samples

        return avg_loss, accuracy

    def train(self, train_graphs: List, train_labels: List,
              val_graphs: List, val_labels: List,
              test_graphs: List, test_labels: List,
              verbose: bool = True) -> Dict:
        """Full training loop."""
        best_val_acc = 0.0
        patience_counter = 0
        patience = 30

        for epoch in range(self.cfg.N_EPOCHS):
            # Learning rate schedule
            lr = self.cosine_annealing_lr(epoch, self.cfg.LEARNING_RATE)
            self.history['learning_rates'].append(lr)

            # Training
            train_loss, train_acc = self.train_epoch(
                train_graphs, train_labels, lr
            )

            # Validation
            val_loss, val_acc = self.evaluate(val_graphs, val_labels)

            # Store metrics
            self.history['train_loss'].append(train_loss)
            self.history['train_accuracy'].append(train_acc)
            self.history['val_loss'].append(val_loss)
            self.history['val_accuracy'].append(val_acc)

            # Early stopping
            if val_acc > best_val_acc:
                best_val_acc = val_acc
                patience_counter = 0
            else:
                patience_counter += 1

            if verbose and epoch % 10 == 0:
                print(f"Epoch {epoch:3d} | "
                      f"Train Loss: {train_loss:.4f} | "
                      f"Train Acc: {train_acc:.4f} | "
                      f"Val Loss: {val_loss:.4f} | "
                      f"Val Acc: {val_acc:.4f} | "
                      f"LR: {lr:.6f}")

            if patience_counter >= patience:
                if verbose:
                    print(f"Early stopping at epoch {epoch}")
                break

        # Final test evaluation
        test_loss, test_acc = self.evaluate(test_graphs, test_labels)
        self.history['test_accuracy'].append(test_acc)

        if verbose:
            print(f"\n{'='*60}")
            print(f"Final Test Accuracy: {test_acc:.4f}")
            print(f"Final Test Loss: {test_loss:.4f}")
            print(f"{'='*60}")

        return self.history

